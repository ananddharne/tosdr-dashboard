# Copy this file to `.env` and fill in your own key. NEVER commit `.env`.
# The server reads MODEL_API_KEY only from the environment (see src/server.ts).
MODEL_API_KEY=your-key-here
# Which provider the key is for: gemini (default, free tier at
# aistudio.google.com) or meta (Meta Model API, paid).
MODEL_PROVIDER=gemini
# Optional: override the model id (default gemini-3.8-flash / muse-spark-1.3).
# MODEL_NAME=gemini-3.8-flash
# Optional: cap the policy text sent for grading (default 400000 characters).
# Use 60000 on a free-tier key to stay within quota.
# RATING_MAX_POLICY_CHARS=400000
# Optional: override the port (default 3001).
# PORT=3001
