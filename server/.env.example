# Copy this file to `.env` and fill in your own key. NEVER commit `.env`.
# The server reads MODEL_API_KEY only from the environment (see src/server.ts).
MODEL_API_KEY=your-key-here
# Optional: override the model id. Check the Meta Model API dashboard/docs
# for the current Muse Spark model ids.
# META_MODEL=muse-spark-1.3
# Optional: override the port (default 3001).
# PORT=3001
